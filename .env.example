# Copia in .env.local
# Segreto del pannello: genera una stringa casuale con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Con il pooler di Supabase l utente e postgres.IDPROGETTO (con il punto), non solo postgres.
PAYLOAD_SECRET=cambiami-con-una-stringa-lunga-e-casuale
# In locale: file SQLite. Online (Vercel): stringa "Transaction pooler" di Supabase, es. postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
DATABASE_URL=file:./data/payload.db

# Foto su Supabase Storage (Storage > S3 Connection). Senza queste variabili le foto restano nella cartella /media (solo locale).
# Il bucket deve essere pubblico. S3_PUBLIC_URL = https://<progetto>.supabase.co/storage/v1/object/public/<bucket>
S3_BUCKET=media
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email di notifica per le richieste di preventivo (SMTP). Senza queste variabili l'email viene scritta solo nella console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
