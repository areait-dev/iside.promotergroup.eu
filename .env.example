# Copia in .env.local
# Segreto del pannello: genera una stringa casuale con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Con il pooler di Supabase l utente e postgres.IDPROGETTO (con il punto), non solo postgres.
PAYLOAD_SECRET=cambiami-con-una-stringa-lunga-e-casuale
# In locale: file SQLite (default, non serve impostare nulla).
# Online (Vercel): database Turso. Url: turso db show --url <nome> · Token: turso db tokens create <nome>
# DATABASE_URI=libsql://nome-db-organizzazione.turso.io
# DATABASE_AUTH_TOKEN=
# In alternativa a Turso: stringa "Transaction pooler" di Supabase (se presente, ha la precedenza), es. postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# DATABASE_URL=
# Solo per le migrazioni (build e npm run db:migrate): "Session pooler" di Supabase, stesso host ma porta 5432. Se manca si usa DATABASE_URL.
# DATABASE_URL_MIGRATE=

# Foto su Supabase Storage (Storage > S3 Connection). Senza queste variabili le foto restano nella cartella /media (solo locale).
# Il bucket deve essere pubblico. S3_PUBLIC_URL = https://<progetto>.supabase.co/storage/v1/object/public/<bucket>
S3_BUCKET=media
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Email di notifica per le richieste di preventivo (SMTP). Senza queste variabili l'email viene scritta solo nella console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
